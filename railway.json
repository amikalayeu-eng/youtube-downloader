{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "sh web_build.sh"
  },
  "deploy": {
    "startCommand": "uvicorn app.direct:app --host 0.0.0.0 --port 8080 --workers 2 --proxy-headers",
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
